{
  "name": "relay-editor",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "main": "electron/editor-main.cjs",
  "scripts": {
    "build": "vite build --configLoader runner",
    "start": "npm run build:desktop && electron .",
    "server": "node scripts/seed-peer.cjs",
    "test": "node --test tests/*.test.js",
    "package:win": "npm run build:desktop && electron-builder --win nsis portable --x64 --publish never",
    "package:linux": "npm run build:desktop && electron-builder --linux deb --x64 --publish never",
    "package:dir": "npm run build:desktop && electron-builder --dir --publish never",
    "build:extension": "node scripts/build-extension.mjs",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "build:desktop": "npm run build:extension && npm run prepare:engine",
    "start:classic": "node -e \"throw new Error('Restore the 0.2 backup to use the classic cloud desktop.')\"",
    "test:engine": "node scripts/test-engine.mjs",
    "seed": "node scripts/seed-peer.cjs",
    "server:legacy": "node legacy/server/index.js",
    "package:beta": "node scripts/package-beta.mjs"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "hyperdht": "6.34.0",
    "hyperswarm": "4.17.2",
    "lib0": "^0.2.114",
    "monaco-editor": "0.55.1",
    "ws": "^8.18.3",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "vite": "^6.1.0"
  },
  "description": "Relay collaborative desktop coding editor",
  "author": {
    "name": "TMystic"
  },
  "homepage": "https://github.com/TMystic/relay",
  "license": "UNLICENSED",
  "build": {
    "appId": "io.github.tmystic.relay",
    "productName": "Relay",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/editor-main.cjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Relay-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Relay-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "TMystic",
      "executableName": "relay",
      "target": [
        "deb"
      ],
      "artifactName": "Relay-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "engine-runtime",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop-assets",
        "to": "desktop-assets",
        "filter": [
          "*.vsix"
        ]
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libasound2 | libasound2t64",
        "libx11-6",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxrandr2",
        "libsecret-1-0",
        "libxkbfile1",
        "libc6 (>= 2.31)"
      ],
      "afterInstall": "scripts/linux-after-install.tpl"
    }
  },
  "overrides": {
    "dompurify": "3.4.16",
    "@electron/get": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
