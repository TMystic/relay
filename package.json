{
  "name": "relay-editor",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build --configLoader runner",
    "start": "npm run build && electron .",
    "server": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux deb --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "lib0": "^0.2.114",
    "monaco-editor": "^0.55.1",
    "ws": "^8.18.3",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "26.15.3",
    "vite": "^6.1.0"
  },
  "description": "Relay collaborative desktop coding editor",
  "author": {
    "name": "TMystic"
  },
  "homepage": "https://github.com/TMystic/relay",
  "license": "UNLICENSED",
  "build": {
    "appId": "io.github.tmystic.relay",
    "productName": "Relay",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Relay-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Relay-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "TMystic",
      "executableName": "relay",
      "target": [
        "deb"
      ],
      "artifactName": "Relay-${version}-${arch}.${ext}"
    }
  }
}
